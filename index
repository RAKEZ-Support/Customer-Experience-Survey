<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>RAKEZ — Your Voice Survey</title>
<style>
  :root{
    --navy:#17203A; --navy-2:#19263C;
    --teal-deep:#005755; --teal:#01C1BC; --teal-2:#00B9B6;
    --gold:#DAA600;
    --ink:#1d2433; --muted:#5b6577; --line:#e4e8ee;
    --bg:#f4f6f9; --card:#ffffff;
    --radius:18px;
    --shadow:0 1px 2px rgba(23,32,58,.06), 0 16px 40px rgba(23,32,58,.08);
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;
    font-family:Calibri,"Segoe UI",system-ui,-apple-system,Arial,sans-serif;
    color:var(--ink); background:var(--bg); line-height:1.55; -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:760px;margin:0 auto;padding:0 20px}

  /* ---------- Header ---------- */
  header.hero{
    background:
      radial-gradient(1100px 300px at 82% -30%, rgba(1,193,188,.22), transparent 60%),
      linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 55%, var(--teal-deep) 135%);
    color:#fff; padding:40px 0 44px; position:relative; overflow:hidden;
  }
  header.hero::after{
    content:"";position:absolute;left:0;right:0;bottom:0;height:4px;
    background:linear-gradient(90deg,var(--teal) 0%,var(--teal-2) 45%,var(--gold) 100%);
  }
  .herotop{display:flex;align-items:center;gap:18px;margin-bottom:26px}
  .logoplate{
    background:#fff;border-radius:14px;padding:11px 15px;flex:0 0 auto;
    box-shadow:0 8px 22px rgba(0,0,0,.18);line-height:0;
  }
  .logoplate img{height:58px;width:auto;display:block}
  .herotop .divider{width:1px;height:40px;background:rgba(255,255,255,.16);flex:0 0 auto}
  .eyebrow{
    font-size:12.5px;letter-spacing:.18em;text-transform:uppercase;
    color:var(--teal);font-weight:700;line-height:1.4;
  }
  header.hero h1{margin:0;font-size:31px;line-height:1.16;font-weight:700;letter-spacing:-.01em}
  header.hero p.sub{margin:13px 0 0;color:#cdd7e4;font-size:16px;max-width:58ch}

  /* ---------- Form card (holds stepper + panels) ---------- */
  main{padding:0 0 60px}
  .formcard{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    box-shadow:var(--shadow);margin-top:-30px;position:relative;z-index:2;overflow:hidden;
  }
  .leadline{
    margin:0;padding:15px 24px;font-size:14.5px;color:var(--muted);
    border-bottom:1px solid var(--line);background:#fbfdfd;
  }
  .leadline b{color:var(--teal-deep);font-weight:700}

  /* ---------- Stepper ---------- */
  .stepper{display:flex;align-items:flex-start;padding:22px 16px 18px;border-bottom:1px solid var(--line)}
  .step{
    flex:1;display:flex;flex-direction:column;align-items:center;gap:9px;
    background:none;border:none;cursor:pointer;position:relative;padding:0;font-family:inherit;
  }
  .step .dot{
    width:34px;height:34px;border-radius:50%;display:grid;place-items:center;
    font-weight:800;font-size:14px;background:#eef1f5;color:var(--muted);
    transition:.15s;z-index:1;
  }
  .step .lbl{font-size:12.5px;font-weight:700;color:var(--muted);text-align:center;line-height:1.25;max-width:11ch}
  .step:focus-visible{outline:none}
  .step:focus-visible .dot{box-shadow:0 0 0 3px rgba(1,193,188,.35)}
  .step.active .dot{background:linear-gradient(135deg,var(--teal-deep),var(--teal-2));color:#fff;box-shadow:0 6px 16px rgba(0,87,85,.28)}
  .step.active .lbl{color:var(--navy)}
  .step.done .dot{background:var(--teal-deep);color:#fff}
  .step.done .lbl{color:var(--teal-deep)}
  .step::before,.step::after{content:"";position:absolute;top:16px;height:2px;background:var(--line);z-index:0}
  .step::before{left:0;right:50%;margin-right:19px}
  .step::after{left:50%;right:0;margin-left:19px}
  .step:first-child::before{display:none}
  .step:last-child::after{display:none}
  .step.done::before,.step.active::before,.step.done::after{background:var(--teal-2)}

  /* ---------- Panels ---------- */
  .panelwrap{padding:26px 24px 22px}
  .panel{display:none;animation:fade .25s ease}
  .panel.active{display:block}
  @keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
  .panel h3{margin:0 0 4px;font-size:21px;color:var(--navy);letter-spacing:-.01em}
  .panel .phint{margin:0 0 4px;color:var(--muted);font-size:14px}

  .field{margin-top:20px}
  .field > label.q{display:block;font-weight:700;color:var(--ink);font-size:15.5px;margin-bottom:4px}
  .field .sub{color:var(--muted);font-size:13px;margin-bottom:10px}
  .opt{font-weight:600;color:var(--teal-deep);font-size:12px;background:#e9f7f6;padding:1px 8px;border-radius:20px;margin-left:6px}

  input[type=text],textarea{
    width:100%;font-family:inherit;font-size:15px;color:var(--ink);background:#fff;
    border:1.5px solid var(--line);border-radius:11px;padding:11px 13px;transition:border-color .15s, box-shadow .15s;
  }
  textarea{resize:vertical;min-height:84px;line-height:1.5}
  input:focus,textarea:focus{outline:none;border-color:var(--teal-2);box-shadow:0 0 0 3px rgba(1,193,188,.18)}

  /* Chip input */
  .chipbox{display:flex;flex-wrap:wrap;gap:8px;align-items:center;border:1.5px solid var(--line);border-radius:11px;padding:8px 10px;background:#fff;transition:border-color .15s, box-shadow .15s}
  .chipbox.focus{border-color:var(--teal-2);box-shadow:0 0 0 3px rgba(1,193,188,.18)}
  .chipbox.full{background:#fbfcfd}
  .chip{display:inline-flex;align-items:center;gap:7px;background:#eef8f7;color:var(--teal-deep);border:1px solid #cdeceb;border-radius:20px;padding:5px 6px 5px 12px;font-size:14px;font-weight:600;animation:pop .14s ease}
  @keyframes pop{from{transform:scale(.85);opacity:0}to{transform:scale(1);opacity:1}}
  .chip button{border:none;background:rgba(0,87,85,.12);color:var(--teal-deep);width:19px;height:19px;border-radius:50%;cursor:pointer;font-size:13px;line-height:1;display:grid;place-items:center;padding:0}
  .chip button:hover{background:var(--teal-deep);color:#fff}
  .chipbox input{border:none;box-shadow:none;flex:1 1 90px;min-width:90px;padding:6px 2px;font-size:15px}
  .chipbox input:focus{box-shadow:none}
  .counter{font-size:12px;color:var(--muted);margin-top:6px}
  .counter.max{color:var(--gold);font-weight:700}

  /* Rating */
  .stars{display:flex;gap:6px;margin-top:4px}
  .stars button{background:none;border:none;cursor:pointer;padding:4px;line-height:0;border-radius:8px}
  .stars button:focus-visible{outline:2px solid var(--teal-2);outline-offset:2px}
  .stars svg{width:34px;height:34px;display:block}
  .stars .st{fill:#e7ebf1;transition:fill .12s,transform .12s}
  .stars button:hover .st{transform:scale(1.08)}
  .stars button.on .st{fill:var(--gold)}
  .ratelabel{font-size:13.5px;color:var(--muted);margin-top:8px;min-height:18px;font-weight:600}

  /* Nav */
  .err{color:#c0392b;font-size:13.5px;font-weight:600;margin:18px 0 0;min-height:18px;text-align:center}
  .navrow{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:8px}
  .btn{
    appearance:none;border:none;cursor:pointer;font-family:inherit;font-weight:700;font-size:15.5px;color:#fff;
    background:linear-gradient(135deg,var(--teal-deep) 0%,var(--teal-2) 100%);
    padding:13px 30px;border-radius:12px;box-shadow:0 10px 24px rgba(0,87,85,.26);
    transition:transform .12s, box-shadow .12s, opacity .12s;
  }
  .btn:hover{transform:translateY(-1px);box-shadow:0 14px 30px rgba(0,87,85,.32)}
  .btn:active{transform:translateY(0)}
  .btn.ghost{background:#fff;color:var(--teal-deep);border:1.5px solid var(--line);box-shadow:none}
  .btn.ghost:hover{border-color:var(--teal-2);transform:none}
  .caption{text-align:center;font-size:12.5px;color:var(--muted);margin:14px 0 0}

  /* Thank you */
  .thanks{display:none;text-align:center;padding:44px 24px}
  .thanks.show{display:block;animation:pop .3s ease}
  .thanks .tick{width:74px;height:74px;border-radius:50%;margin:0 auto 18px;display:grid;place-items:center;background:linear-gradient(135deg,var(--teal-deep),var(--teal-2));box-shadow:0 12px 28px rgba(0,87,85,.3)}
  .thanks .tick svg{width:38px;height:38px;stroke:#fff;stroke-width:3;fill:none}
  .thanks h2{margin:0 0 8px;color:var(--navy);font-size:24px}
  .thanks p{color:var(--muted);font-size:15.5px;max-width:48ch;margin:0 auto}

  footer{padding:26px 0 40px;text-align:center;color:#93a0b3;font-size:12.5px}
  footer .bar{width:44px;height:3px;background:linear-gradient(90deg,var(--teal),var(--gold));border-radius:2px;margin:0 auto 14px}

  @media (max-width:540px){
    header.hero h1{font-size:24px}
    header.hero{padding:32px 0 40px}
    .logoplate{padding:9px 12px}
    .logoplate img{height:44px}
    .herotop{gap:13px;margin-bottom:22px}
    .panelwrap{padding:22px 17px 20px}
    .wrap{padding:0 15px}
    .step .lbl{font-size:11px}
    .step .dot{width:30px;height:30px;font-size:13px}
    .step::before{margin-right:16px}
    .step::after{margin-left:16px}
    .btn{padding:12px 20px;font-size:14.5px}
  }
  @media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important;scroll-behavior:auto}}
</style>
</head>
<body>

<header class="hero">
  <div class="wrap">
    <div class="herotop">
      <div class="logoplate"><img src="data:image/png;base64," alt="RAKEZ — Ras Al Khaimah Economic Zone" /></div>
      <div class="divider"></div>
      <span class="eyebrow">Shaping our<br>future together</span>
    </div>
    <h1>Your voice, in your words</h1>
    <p class="sub">We're rethinking the RAKEZ experience — and the people who know it best are the ones who use it. Tell us how RAKEZ feels today and what you want it to become.</p>
  </div>
</header>

<main>
<div class="wrap">
  <div class="formcard" id="formcard">
    <p class="leadline">Takes about <b>3 minutes</b> — there are no right answers, just your honest first reactions.</p>

    <!-- Stepper -->
    <div class="stepper" id="stepper">
      <button type="button" class="step active" aria-current="step"><span class="dot">1</span><span class="lbl">About you</span></button>
      <button type="button" class="step"><span class="dot">2</span><span class="lbl">RAKEZ today</span></button>
      <button type="button" class="step"><span class="dot">3</span><span class="lbl">What you want</span></button>
      <button type="button" class="step"><span class="dot">4</span><span class="lbl">Anything else</span></button>
    </div>

    <div class="panelwrap">
      <form id="surveyForm" onsubmit="return false">

        <!-- Step 1 -->
        <section class="panel active" data-panel="0">
          <h3>About you</h3>
          <p class="phint">Just so we can attribute your feedback correctly.</p>
          <div class="field">
            <label class="q" for="company">Company / entity name</label>
            <input type="text" id="company" placeholder="Your company name" autocomplete="organization" />
          </div>
        </section>

        <!-- Step 2 -->
        <section class="panel" data-panel="1">
          <h3>How RAKEZ feels today</h3>
          <p class="phint">Your gut reaction — the first words that come to mind.</p>
          <div class="field">
            <label class="q">When you think of RAKEZ, what comes to mind?</label>
            <div class="sub">Add three or four words or short phrases — type one and press Enter.</div>
            <div class="chipbox" data-chip="perception" data-max="4">
              <input type="text" placeholder="e.g. reliable, slow, supportive…" aria-label="Words that describe RAKEZ today" />
            </div>
            <div class="counter" data-counter="perception">0 of 4 added</div>
          </div>
          <div class="field">
            <label class="q" for="perceptionWhy">Anything behind those words? <span class="opt">optional</span></label>
            <textarea id="perceptionWhy" placeholder="A moment or experience that shaped how you see RAKEZ…"></textarea>
          </div>
        </section>

        <!-- Step 3 -->
        <section class="panel" data-panel="2">
          <h3>What you want RAKEZ to be</h3>
          <p class="phint">Look ahead — describe the RAKEZ you'd choose to work with.</p>
          <div class="field">
            <label class="q" for="wantToBe">What do you want RAKEZ to be for you?</label>
            <div class="sub">In your own words — a partner, an enabler, a problem-solver? Say it however feels right.</div>
            <textarea id="wantToBe" placeholder="I want RAKEZ to be…"></textarea>
          </div>
          <div class="field">
            <label class="q">How should engaging with RAKEZ feel?</label>
            <div class="sub">The feeling you'd want every interaction to leave you with. Add up to four words.</div>
            <div class="chipbox" data-chip="feeling" data-max="4">
              <input type="text" placeholder="e.g. effortless, valued, fast…" aria-label="How engaging with RAKEZ should feel" />
            </div>
            <div class="counter" data-counter="feeling">0 of 4 added</div>
          </div>
        </section>

        <!-- Step 4 -->
        <section class="panel" data-panel="3">
          <h3>Anything else?</h3>
          <p class="phint">Both parts are optional — share only if you'd like to.</p>
          <div class="field">
            <label class="q" for="feedback">Open feedback <span class="opt">optional</span></label>
            <textarea id="feedback" placeholder="Anything you'd change, keep, or wish RAKEZ knew…"></textarea>
          </div>
          <div class="field">
            <label class="q">Overall, how would you rate RAKEZ today? <span class="opt">optional</span></label>
            <div class="stars" id="stars" role="radiogroup" aria-label="Overall rating out of 5"></div>
            <div class="ratelabel" id="rateLabel"></div>
          </div>
        </section>

      </form>

      <p class="err" id="err"></p>
      <div class="navrow">
        <button type="button" class="btn ghost" id="backBtn" style="visibility:hidden">Back</button>
        <button type="button" class="btn" id="nextBtn">Next</button>
      </div>
      <p class="caption" id="caption"></p>
    </div>
  </div>

  <!-- Thank you -->
  <section class="formcard thanks" id="thanks">
    <div class="tick"><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg></div>
    <h2>Thank you</h2>
    <p>Your responses have downloaded as a file. Please send it back to us — your perspective genuinely shapes the direction RAKEZ takes next.</p>
  </section>
</div>
</main>

<footer>
  <div class="wrap">
    <div class="bar"></div>
    RAKEZ Customer Experience Programme · Ras Al Khaimah Economic Zone
  </div>
</footer>

<script>
/* ============================================================
   CONFIG — segments are used only to tag the response.
   Send one link per segment, e.g. survey.html?segment=Industrial
   ============================================================ */
const CONFIG = {
  segments: ["Industrial", "Non-Industrial", "Agents", "Freelancer / Individual"],
  // 1) Create a Google Sheet + Apps Script Web App (see setup notes), then
  // 2) paste its Web App URL below. Until you do, the form falls back to
  //    downloading a JSON file so you can still test it locally.
  endpoint: "https://script.google.com/macros/s/AKfycbyh-C_LWwBDYXcfVHuNLRaST7vz2zEghUMWbaDwBpCZIQ3LhZMDwoYQclbfcPxzVWak/exec"
};

const $  = (s, r=document) => r.querySelector(s);
const $$ = (s, r=document) => [...r.querySelectorAll(s)];

/* Segment comes silently from the link */
const params = new URLSearchParams(location.search);
const rawSeg = params.get("segment") || "";
const SEGMENT = CONFIG.segments.includes(rawSeg) ? rawSeg : rawSeg;

/* ---------- Chip inputs ---------- */
const chipStore = {};
$$(".chipbox").forEach(box => {
  const key = box.dataset.chip;
  const max = parseInt(box.dataset.max, 10);
  const input = $("input", box);
  const counter = $('[data-counter="'+key+'"]');
  chipStore[key] = [];
  input.dataset.ph = input.placeholder;

  function render(){
    $$(".chip", box).forEach(c => c.remove());
    chipStore[key].forEach((w, i) => {
      const chip = document.createElement("span");
      chip.className = "chip";
      chip.innerHTML = '<span></span><button type="button" aria-label="Remove">×</button>';
      chip.querySelector("span").textContent = w;
      chip.querySelector("button").onclick = () => { chipStore[key].splice(i,1); render(); };
      box.insertBefore(chip, input);
    });
    const n = chipStore[key].length;
    counter.textContent = n + " of " + max + " added";
    counter.classList.toggle("max", n >= max);
    const full = n >= max;
    box.classList.toggle("full", full);
    input.style.display = full ? "none" : "";
    input.placeholder = n === 0 ? input.dataset.ph : "add another…";
  }
  function addWord(raw){
    const w = raw.trim().replace(/,+$/,"").trim();
    if(!w) return;
    if(chipStore[key].length >= max) return;
    if(chipStore[key].some(x => x.toLowerCase() === w.toLowerCase())){ input.value=""; return; }
    chipStore[key].push(w); input.value=""; render();
  }
  input.addEventListener("keydown", e => {
    if(e.key === "Enter" || e.key === ","){ e.preventDefault(); addWord(input.value); }
    else if(e.key === "Backspace" && input.value === "" && chipStore[key].length){ chipStore[key].pop(); render(); }
  });
  input.addEventListener("blur", () => addWord(input.value));
  box.addEventListener("click", () => input.focus());
  input.addEventListener("focus", () => box.classList.add("focus"));
  input.addEventListener("blur", () => box.classList.remove("focus"));
  render();
});

/* ---------- Star rating ---------- */
let rating = 0;
const rateWords = ["", "Poor", "Fair", "Good", "Very good", "Excellent"];
const starsWrap = $("#stars");
const rateLabel = $("#rateLabel");
function starSVG(){ return '<svg viewBox="0 0 24 24"><path class="st" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.5 1.3 6.6-5.9-3.3-5.9 3.3 1.3-6.6-4.9-4.5 6.6-.8z"/></svg>'; }
for(let i=1;i<=5;i++){
  const b = document.createElement("button");
  b.type="button"; b.setAttribute("role","radio"); b.setAttribute("aria-label", i+" of 5");
  b.innerHTML = starSVG();
  b.addEventListener("click", () => setRating(i));
  b.addEventListener("mouseenter", () => paint(i));
  b.addEventListener("mouseleave", () => paint(rating));
  starsWrap.appendChild(b);
}
function paint(n){ $$("#stars button").forEach((b,idx) => b.classList.toggle("on", idx < n)); }
function setRating(n){ rating = n; paint(n); rateLabel.textContent = rateWords[n]; $$("#stars button").forEach((b,idx)=>b.setAttribute("aria-checked", idx===n-1)); }

/* ---------- Stepper navigation ---------- */
const panels = $$(".panel");
const steps  = $$(".step");
const backBtn = $("#backBtn");
const nextBtn = $("#nextBtn");
const err = $("#err");
const caption = $("#caption");
let cur = 0;

function go(i){
  cur = Math.max(0, Math.min(panels.length-1, i));
  panels.forEach((p,idx) => p.classList.toggle("active", idx===cur));
  steps.forEach((s,idx) => {
    s.classList.toggle("active", idx===cur);
    s.classList.toggle("done", idx<cur);
    s.setAttribute("aria-current", idx===cur ? "step" : "false");
  });
  backBtn.style.visibility = cur===0 ? "hidden" : "visible";
  const last = cur === panels.length-1;
  nextBtn.textContent = last ? "Download my responses" : "Next";
  caption.textContent = last ? "Your answers download as a file you can send back to RAKEZ." : "";
  err.textContent = "";
  $("#formcard").scrollIntoView({behavior:"smooth", block:"start"});
}
steps.forEach((s,idx) => s.addEventListener("click", () => go(idx)));
backBtn.onclick = () => go(cur-1);
nextBtn.onclick = () => { if(cur < panels.length-1) go(cur+1); else submitResponse(); };

/* ---------- Collect + submit ---------- */
function collect(){
  return {
    submittedAt: new Date().toISOString(),
    segment: SEGMENT,
    company: $("#company").value.trim(),
    perception: chipStore.perception,
    perceptionWhy: $("#perceptionWhy").value.trim(),
    wantRakezToBe: $("#wantToBe").value.trim(),
    engagementFeeling: chipStore.feeling,
    openFeedback: $("#feedback").value.trim(),
    rating: rating || null
  };
}
function slug(s){ return (s||"").replace(/[^\w]+/g,"-").replace(/^-+|-+$/g,"").toLowerCase(); }

function showThanks(){
  $("#formcard").style.display = "none";
  const t = $("#thanks"); t.classList.add("show");
  t.scrollIntoView({behavior:"smooth", block:"center"});
}

/* Fallback used only before the endpoint is configured — keeps local testing working */
function downloadJSON(data){
  const name = slug(data.company) || slug(data.segment) || "response";
  const blob = new Blob([JSON.stringify(data, null, 2)], {type:"application/json"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = "rakez-voice-" + name + ".json";
  document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
}

function submitResponse(){
  const data = collect();
  if(data.perception.length === 0){
    go(1);
    err.textContent = "Please add at least one word for how RAKEZ feels today.";
    return;
  }

  const configured = CONFIG.endpoint && !CONFIG.endpoint.startsWith("PASTE_");
  if(!configured){
    // No Sheet endpoint set yet — keep the old download so the form still works
    downloadJSON(data);
    showThanks();
    return;
  }

  const originalLabel = nextBtn.textContent;
  nextBtn.disabled = true; nextBtn.textContent = "Submitting…";
  err.textContent = "";

  fetch(CONFIG.endpoint, {
    method: "POST",
    mode: "no-cors",                                  // sidesteps Apps Script CORS preflight
    headers: { "Content-Type": "text/plain;charset=utf-8" },
    body: JSON.stringify(data)
  })
  .then(() => showThanks())
  .catch(() => {
    nextBtn.disabled = false; nextBtn.textContent = originalLabel;
    err.textContent = "Sorry, we couldn't submit just now. Please check your connection and try again.";
  });
}
</script>
</body>
</html>
